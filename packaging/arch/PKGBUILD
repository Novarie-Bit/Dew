# Builds the surrounding checkout:  cd packaging/arch && makepkg -sif
# (-f rebuilds even if pkgver is unchanged, so updates from git pull get built)
pkgname=dew
pkgver=0.2.0
pkgrel=1
pkgdesc="Assignment tracker for Canvas and Gradescope (desktop app + TUI)"
arch=('x86_64' 'aarch64')
url="https://github.com/novarie-bit/dew"
license=('custom')
# The GUI loads these at runtime (Wayland or X11, plus OpenGL); the sign-in
# window is WebKitGTK.
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi'
         'webkit2gtk-4.1' 'gtk3')
makedepends=('cargo' 'cmake' 'pkgconf')
optdepends=('xdg-utils: open assignments in the browser'
            'waybar: status bar module')
options=('!lto')

_root() { realpath "$startdir/../.."; }

prepare() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen
}

package() {
  install -Dm755 "$srcdir/target/release/dew" "$pkgdir/usr/bin/dew"
  install -Dm644 "$(_root)/packaging/dew.desktop" "$pkgdir/usr/share/applications/dew.desktop"
  install -Dm644 "$(_root)/packaging/waybar/config.jsonc" "$pkgdir/usr/share/doc/dew/waybar-config.jsonc"
  install -Dm644 "$(_root)/packaging/waybar/style.css" "$pkgdir/usr/share/doc/dew/waybar-style.css"
  install -Dm644 "$(_root)/README.md" "$pkgdir/usr/share/doc/dew/README.md"
}
